{
  "name": "chapter10",
  "version": "1.0.0",
  "description": "Webpack5 模块联邦 Demo",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:host": "webpack --config webpack.host.config.ts --mode production",
    "build:remote": "webpack --config webpack.remote.config.ts --mode production",
    "start": "concurrently \"pnpm:dev:host\" \"pnpm:dev:remote\"",
    "dev:host": "webpack serve --config webpack.host.config.ts --mode development",
    "dev:remote": "webpack serve --config webpack.remote.config.ts --mode development"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "@vue/compiler-sfc": "^3.5.13",
    "concurrently": "^9.1.2",
    "css-loader": "^6.11.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "sass": "^1.83.4",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vue-loader": "^17.4.2",
    "vue-style-loader": "^4.1.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
